# ── Design Reasoning ─────────────────────────────────────────────────────────
# Groq: free at console.groq.com (no credit card required)
# Model used: llama-3.3-70b-versatile
# FREE-ALT: Replaces Gemma/Vultr SSH for furniture polycount and dimension estimation
# KENNEY-ALT: Also used for keyword extraction in furniture library matching
GROQ_API_KEY="keep your fuck**g key"

# ── Room Image Analysis ──────────────────────────────────────────────────────
# Gemini: free at aistudio.google.com (no credit card required)
# Model used: gemini-2.5-flash
# FREE-ALT: For future room image analysis (currently unused)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Product Search ────────────────────────────────────────────────────────────
# SerpAPI: 100 free searches/month at serpapi.com
SERPAPI_API_KEY=your_serpapi_key_here

# ── Text-to-3D Furniture ──────────────────────────────────────────────────────
# KENNEY-ALT: Replaced with local Kenney furniture asset library (35+ items)
# Furniture matching is instant (no API calls), uses tag-based scoring + Groq keyword extraction
# Available assets: /public/assets/furniture/manifest.json
# Note: MESHY_API_KEY is no longer needed
MESHY_API_KEY=
MESHY_API_BASE=https://api.meshy.ai/openapi/v2

# ── Immersive Room View ───────────────────────────────────────────────────────
# World Labs: leave empty — feature shows "coming soon" message
# FREE-ALT: When empty, displays "Immersive View — Coming Soon" with graceful degradation
WORLDLABS_API_KEY=
WORLDLABS_API_BASE=https://api.worldlabs.ai/marble/v1

# ── DISABLED: Gemma on Vultr (replaced by Groq above) ──────────────────────────
# These environment variables are no longer used
# GEMMA_SSH_HOST=
# GEMMA_SSH_USER=root
# GEMMA_SSH_PASSWORD=
